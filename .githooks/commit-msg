#!/usr/bin/env bash
#
# Enforces commit message policy:
#   1. No AI agent co-author / generated-by trailers
#   2. Subject line <= 72 characters
#   3. Subject line is pure ASCII
#   4. Subject follows Conventional Commits
#
# Installed via: git config core.hooksPath .githooks

set -uo pipefail

msg_file="$1"
fail=0

err() {
	printf '\033[31mcommit-msg: %s\033[0m\n' "$1" >&2
	fail=1
}

# Strip comment lines so `git commit -v` diffs and template comments are ignored.
body="$(grep -v '^#' "$msg_file")"
subject="$(printf '%s\n' "$body" | sed -n '1p')"

# --- 1. No AI agent attribution -------------------------------------------
ai_pattern='(claude|anthropic|copilot|cursor|codex|chatgpt|gpt-[0-9]|openai|gemini|devin|windsurf|aider|cody|amp|sourcegraph|tabnine|codeium|jules|junie|zed[[:space:]]agent|ai[[:space:]]assistant|bot@)'

while IFS= read -r line; do
	case "$line" in
	[Cc]o-[Aa]uthored-[Bb]y:* | [Cc]o-[Aa]uthored[[:space:]][Bb]y:*)
		if printf '%s' "$line" | grep -qiE "$ai_pattern"; then
			err "AI agent co-author trailers are not allowed: $line"
		fi
		;;
	esac
	if printf '%s' "$line" | grep -qiE '(generated with|co-created with|assisted by|authored by)[[:space:]]*\[?(claude|chatgpt|copilot|cursor|codex|gemini|devin)'; then
		err "AI agent attribution lines are not allowed: $line"
	fi
done <<<"$body"

# --- 2. Subject length -----------------------------------------------------
subject_len=${#subject}
if [ "$subject_len" -gt 72 ]; then
	err "subject is $subject_len characters, maximum is 72"
fi

if [ "$subject_len" -eq 0 ]; then
	err "subject line is empty"
fi

# --- 3. Subject is ASCII ---------------------------------------------------
if printf '%s' "$subject" | LC_ALL=C grep -q '[^ -~]'; then
	err "subject contains non-ASCII characters (no emoji, smart quotes, or dashes)"
fi

# --- 4. Conventional Commits ----------------------------------------------
conventional='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-z0-9._/-]+\))?!?: .+'

if ! printf '%s' "$subject" | grep -qE "$conventional"; then
	# Allow merge and revert commits generated by git itself.
	case "$subject" in
	Merge\ * | Revert\ \"*) ;;
	*)
		err "subject must follow Conventional Commits, e.g. 'feat(tokens): add colour scale'"
		err "  allowed types: build chore ci docs feat fix perf refactor revert style test"
		err "  got: $subject"
		;;
	esac
fi

if [ "$fail" -ne 0 ]; then
	printf '\ncommit rejected. Fix the message above and try again.\n' >&2
	exit 1
fi

exit 0
