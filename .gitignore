node_modules/
dist/
dist-ssr/
*.tsbuildinfo
.DS_Store

# Playwright working files. Note that apps/*/screenshots and apps/*/test-results
# ARE committed on purpose: they are the evaluation evidence.
playwright-report/
.playwright/
blob-report/
test-results-tmp/

# Local env
.env
.env.local

# The preview is a scratch control, not evidence: its screenshots and results
# are regenerated on demand and would only add churn. The eight real demos DO
# commit theirs.
packages/host-preview/screenshots/
packages/host-preview/test-results/

# Playwright's per-test working dir (traces, error contexts). The JSON files
# written alongside it in test-results/ ARE evidence and stay committed.
apps/*/test-results/playwright/

# Assembled comparison site, rebuilt by `pnpm site`.
_site/
