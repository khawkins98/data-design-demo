{
  "name": "@undrr-eval/root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "UNDRR evaluation of data design systems: controlled UI-library comparison scaffold.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "pnpm -r --filter \"./apps/*\" build",
    "build:packages": "pnpm -r --filter \"./packages/*\" build",
    "dev": "pnpm -r --parallel dev",
    "typecheck": "tsc --build --verbose",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm -r --filter \"./apps/*\" test:e2e",
    "docs:index": "node scripts/build-docs-index.mjs",
    "fixtures:generate": "node scripts/generate-fixtures.mjs",
    "tokens:css": "node --experimental-strip-types scripts/generate-tokens-css.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm docs:index"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
